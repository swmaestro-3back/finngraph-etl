# 앱 로그와 Airflow 로그 레벨
LOG_LEVEL=INFO

# === ETL DB ===
# 호스트에서 접속할 때의 값. Airflow 컨테이너 안에서는 compose가 db:5432로 덮어쓴다.
DATABASE_URL=postgresql+psycopg://threeback:12345678@localhost:15432/finngraph
ETL_DB_PORT=15432

# === AIRFLOW ===
# Linux 호스트에서 마운트 파일 소유권 문제가 있으면 `id -u` 값으로 설정한다.
AIRFLOW_UID=50000
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_WEB_PORT=8080

# === OpenDART ===
# 발급: https://opendart.fss.or.kr 회원가입 후 인증키 신청 (무료, 일 20,000회)
# 인증키는 기본값이 없다. 비우면 법인·개요·재무·설명·공시 수집이 전부 실패한다.
# 일 20,000건 한도라 초당 값보다 회차당 처리량이 병목이다 — batch_size로 조절한다.
# OPENDART_API_KEY 도 같은 값으로 인식한다(둘 중 하나만 설정하면 된다).
DART_API_KEY=your-dart-api-key
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_RATE_LIMIT_PER_SECOND=10
# 개요·재무 모두 service_companies로 좁혀져 있어 한 회차에 거의 다 돈다.
DART_PROFILE_BATCH_SIZE=200
DART_FINANCIAL_BATCH_SIZE=100
# 재무를 몇 개 회계연도까지 소급할지.
DART_FINANCIAL_YEARS=3

# === disclosures: 단일판매ㆍ공급계약체결 공시 ===
# 백필 소급 연수 / 일별 갱신 되짚음 구간 / 회차당 원문 조회 상한(일 호출 한도 안전판).
DISCLOSURE_BACKFILL_YEARS=1
DISCLOSURE_DAILY_LOOKBACK_DAYS=3
DISCLOSURE_FETCH_BATCH_SIZE=8000

# === 한국투자증권(KIS) Open API ===
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_RATE_LIMIT_PER_SECOND=15
# 접근토큰은 발급 자체에 분당 1회 제한이 있고 유효기간이 24시간이다. job마다 새로 발급하면
# 곧바로 한도에 걸리므로 파일에 캐시해 프로세스 간에 재사용한다.
KIS_TOKEN_CACHE_PATH=/tmp/etl-kis-token.json

# === 주가 수집 범위 ===
# 일봉 백필 소급 연수와, 일별 갱신 시 되짚어볼 구간. 갱신 구간이 짧으면 휴장·장애로 빠진
# 날을 영영 못 채우고, 길면 매일 그만큼 재조회한다.
STOCK_DAILY_BACKFILL_YEARS=5
STOCK_DAILY_LOOKBACK_DAYS=10
STOCK_PERIOD_LOOKBACK_DAYS=120

# === news: 수집 API/크롤러 (pipelines/news/config.py) ===
# 숫자 값들은 기본값 없이 import 시점에 int/float 캐스팅되므로 비우면 news 태스크가 즉시 실패한다.
CLIENT_ID=your-news-api-client-id
CLIENT_SECRET=
API_BASE_URL=
SEARCH_DISPLAY=100
# 최신순(date). 테마 last_searched_at 을 워터마크로 삼아 이전 런이 본 기사에서 페이지를 멈춘다.
SEARCH_SORT=date
# 종목명으로 검색어를 만드는 서식 목록(JSON 배열). {name} 자리에 종목명이 들어가고, 서식마다 한 번씩 검색한다.
NEWS_SEARCH_QUERY_TEMPLATES=["{name},공급","{name},계약","{name},수혜","{name},호재","{name},악재","{name},특징주"]
# 종목당 페이지 상한.
NEWS_SEARCH_MAX_PAGES=5
# 워터마크가 없는 종목(첫 검색)은 이 일수까지만 거슬러 수집한다.
NEWS_SEARCH_LOOKBACK_DAYS=180
# 같은 기업을 다시 검색하는 간격(시간). search_history.last_searched_at 기준으로 대상만 거른다.
NEWS_SEARCH_INTERVAL_HOURS=2
# 백엔드가 핫테마(etl:hot-themes)를 발행하는 Redis. 조회에 실패하면 테마 선정 태스크가 실패한다.
HOT_THEMES_REDIS_URL=redis://localhost:16379/0
REQUEST_DELAY=0.5
# 본문 크롤링 동시 요청 수(스레드풀). 기사 간 REQUEST_DELAY 대기는 걸지 않는다.
NEWS_BODY_FETCH_WORKERS=8
ANCHOR_HOST=

# 뉴스 통합 파이프라인 클러스터링 파라미터.
# 검색 대상은 env가 아니라 DAG 파라미터 theme_ids 로 받는다. 종목명은 theme_stocks 에서 읽는다.
NEWS_CLUSTER_THRESHOLD=0.35
NEWS_CLUSTER_DESCRIPTION_WEIGHT=0.4
# 클러스터의 발행일 폭(일). 첫 기사 발행 후 이 일수 안의 기사만 같은 클러스터가 된다.
NEWS_CLUSTER_WINDOW_DAYS=7
# 클러스터 첫 기사보다 먼저 발행된 기사를 받아 주는 여유(일)
NEWS_CLUSTER_BACKWARD_DAYS=1
# 전역 IDF 집계 범위(일)
NEWS_CLUSTER_IDF_DAYS=90
# 클러스터 판정에 쓰는 본문 리드 길이(자)
NEWS_CLUSTER_LEAD_CHARS=200
# 후보 기사가 이 수에 이르면 대표 기사를 정한다(승격)
NEWS_CLUSTER_PROMOTE_SIZE=5
# 승격·제목 생성 재시도 범위(일)
NEWS_CLUSTER_PROMOTE_RETRY_DAYS=3
# 대표 후보 본문의 글자 수 하한
NEWS_CLUSTER_REPRESENTATIVE_MIN_CHARS=200
# 클러스터에 남길 상위 토큰 수.
NEWS_CLUSTER_KEYWORD_COUNT=6
NEWS_CLUSTER_TITLE_MAX_CHARS=25

# === news: DB 직접 접속(psycopg 3 경로) ===
# 추후 common.clients.postgres 로 pool 관리 변경되면 삭제 예정 
# Airflow 컨테이너 안에서는 compose가 DB_HOST/DB_PORT를 db:5432로 덮어쓴다.
DB_HOST=localhost
DB_PORT=15432
DB_NAME=finngraph
DB_USER=threeback
DB_PASSWORD=12345678

# === news: LLM 요약(summarize_articles 잡) — 모델은 공통 BEDROCK_CHAT_MODEL을 쓴다 ===
NEWS_LLM_BODY_LIMIT=12000
NEWS_LLM_MAX_TOKENS=1024
NEWS_LLM_MAX_CONCURRENCY=4
# 관련성 필터가 LLM 호출 한 번에 묶는 기사 수. 10 을 넘기면 뒤쪽 기사 판정이 흐려진다.
NEWS_LLM_BATCH_SIZE=10
# 본문에만 나온 기업 후보가 이 수를 넘는 기사는 여러 종목을 모은 기사로 보고 저장하지 않는다.
NEWS_BODY_CANDIDATE_MAX=15

# === events: 뉴스 클러스터 → Neo4j Event 승격 (pipelines/events/config.py) ===
# 후보 스캔 일수. 승격 기준은 NEWS_CLUSTER_PROMOTE_SIZE 를 그대로 쓴다.
NEWS_EVENT_SCAN_DAYS=15
# HAS_EVENT 로 잇는 기업은 클러스터 후보 기사 중 이 수 이상에 연결(news_companies)된 기업.
NEWS_EVENT_COMPANY_MIN_ARTICLES=2

BEDROCK_REGION=us-east-1
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_REQUEST_TIMEOUT=500
AWS_BEARER_TOKEN_BEDROCK=your-aws-bedrock-token
# 테마 임베딩(embed_themes 잡)용. 임베딩 모델은 kg-api(질의 측)와 동일해야 한다.
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_MAX_WORKERS=32

# === 백엔드 내부 API: 핫테마 발행(publish_hot_themes)·브리핑 생성(publish_briefing) 트리거 ===
# 둘 중 하나라도 비어 있으면 두 태스크가 실패한다. 토큰은 X-Internal-Token 헤더로 보낸다.
BACKEND_INTERNAL_URL=http://localhost:8000
INTERNAL_API_TOKEN=your-internal-api-token

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=finngraph
