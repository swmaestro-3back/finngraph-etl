# 앱 로그와 Airflow 로그 레벨
LOG_LEVEL=INFO

# === ETL DB ===
# 호스트에서 접속할 때의 값. Airflow 컨테이너 안에서는 compose가 db:5432로 덮어쓴다.
DATABASE_URL=postgresql+psycopg://threeback:12345678@localhost:15432/finngraph
ETL_DB_PORT=15432

# === AIRFLOW ===
# Linux 호스트에서 마운트 파일 소유권 문제가 있으면 `id -u` 값으로 설정한다.
AIRFLOW_UID=50000
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_WEB_PORT=8080

# === 한국투자증권(KIS) Open API ===
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_RATE_LIMIT_PER_SECOND=15
# 접근토큰은 발급 자체에 분당 1회 제한이 있고 유효기간이 24시간이다. job마다 새로 발급하면
# 곧바로 한도에 걸리므로 파일에 캐시해 프로세스 간에 재사용한다.
KIS_TOKEN_CACHE_PATH=/tmp/etl-kis-token.json

STOCK_INTRADAY_RETENTION_DAYS=60
STOCK_INTRADAY_TARGET_DELAY_MINUTES=5

# === 주가 수집 범위 ===
# 일봉 백필 소급 연수와, 일별 갱신 시 되짚어볼 구간. 갱신 구간이 짧으면 휴장·장애로 빠진
# 날을 영영 못 채우고, 길면 매일 그만큼 재조회한다.
STOCK_DAILY_BACKFILL_YEARS=10
STOCK_DAILY_LOOKBACK_DAYS=10
STOCK_PERIOD_LOOKBACK_DAYS=120

# === news: 수집 API/크롤러 (pipelines/news/config.py) ===
# 숫자 값들은 기본값 없이 import 시점에 int/float 캐스팅되므로 비우면 news 태스크가 즉시 실패한다.
CLIENT_ID=your-news-api-client-id
CLIENT_SECRET=
API_BASE_URL=
SEARCH_DISPLAY=100
SEARCH_SORT=date
MAX_PAGES=3
KEYWORD_SEARCH_BATCH_SIZE=20
MAX_TOTAL_COLLECTED_ITEMS=200
OFFICIAL_SOURCE_THRESHOLD=2
REQUEST_DELAY=0.5
HEADLINE_MORE_COUNT=3
ANCHOR_HOST=
ANCHOR_URL_TEMPLATE=
# JSON 객체. 예: {"100": "정치", "101": "경제"}
ANCHOR_CATEGORIES=
MORE_API_PATH_SECTION=
MORE_API_PATH_LATEST=
PARENT_SECTION_ID=
HEADLINE_SELECTOR=

# === news: DB 직접 접속(psycopg 3 경로) ===
# 추후 common.clients.postgres 로 pool 관리 변경되면 삭제 예정 
# Airflow 컨테이너 안에서는 compose가 DB_HOST/DB_PORT를 db:5432로 덮어쓴다.
DB_HOST=localhost
DB_PORT=15432
DB_NAME=finngraph
DB_USER=threeback
DB_PASSWORD=12345678

# === news: LLM 필터 ===
MATERIAL_EVENT_FILTER_PROVIDER=bedrock
MATERIAL_EVENT_FILTER_BODY_LIMIT=2000
MATERIAL_EVENT_FILTER_MAX_TOKENS=512
MATERIAL_EVENT_FILTER_MAX_WORKERS=4
MATERIAL_EVENT_FILTER_BATCH_SIZE=10

BEDROCK_REGION=
BEDROCK_CHAT_MODEL=
BEDROCK_REQUEST_TIMEOUT=
AWS_BEARER_TOKEN_BEDROCK=

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=finngraph
