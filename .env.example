LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://threeback:12345678@localhost:15432/finngraph
ETL_DB_PORT=15432

AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_WEB_PORT=8080

DART_API_KEY=your-dart-api-key
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_RATE_LIMIT_PER_SECOND=10
DART_PROFILE_BATCH_SIZE=200
DART_FINANCIAL_BATCH_SIZE=100
DART_FINANCIAL_YEARS=3

DISCLOSURE_BACKFILL_YEARS=1
DISCLOSURE_DAILY_LOOKBACK_DAYS=3
DISCLOSURE_FETCH_BATCH_SIZE=8000

KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_RATE_LIMIT_PER_SECOND=15
KIS_TOKEN_CACHE_PATH=/tmp/etl-kis-token.json

STOCK_DAILY_BACKFILL_YEARS=5
STOCK_DAILY_LOOKBACK_DAYS=10
STOCK_PERIOD_LOOKBACK_DAYS=120

CLIENT_ID=your-news-api-client-id
CLIENT_SECRET=
API_BASE_URL=
SEARCH_DISPLAY=100
SEARCH_SORT=date
MAX_PAGES=3
OFFICIAL_SOURCE_THRESHOLD=2
REQUEST_DELAY=0.5
ANCHOR_HOST=

NEWS_CLUSTER_THRESHOLD=0.35
NEWS_CLUSTER_DESCRIPTION_WEIGHT=0.4
NEWS_CLUSTER_MAX_ARTICLES=3
NEWS_CLUSTER_WINDOW_DAYS=14
NEWS_CLUSTER_KEYWORD_COUNT=6

DB_HOST=localhost
DB_PORT=15432
DB_NAME=finngraph
DB_USER=threeback
DB_PASSWORD=12345678

NEWS_LLM_BODY_LIMIT=12000
NEWS_LLM_MAX_TOKENS=1024
NEWS_LLM_MAX_CONCURRENCY=4
NEWS_LLM_MAX_ITEMS_PER_RUN=300
# 뉴스 클러스터 → Neo4j Event 승격 (pipelines/events)
NEWS_EVENT_MIN_SIZE=2
NEWS_EVENT_SCAN_DAYS=15
NEWS_EVENT_MAX_ITEMS_PER_RUN=50
NEWS_EVENT_LLM_MAX_CONCURRENCY=4
NEWS_EVENT_LEAD_CHARS=600
NEWS_EVENT_TITLE_MAX_CHARS=60

BEDROCK_REGION=us-east-1
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_REQUEST_TIMEOUT=500
AWS_BEARER_TOKEN_BEDROCK=your-aws-bedrock-token
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=finngraph
